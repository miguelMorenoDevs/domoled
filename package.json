{
  "name": "domo-led",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\"",
    "build": "tsc",
    "lg:build": "tsc -p lg-app && esbuild lg-app/src/main.ts --bundle --format=iife --target=es2017 --outfile=lg-app/dist/app.js && node lg-app/copy-static.mjs",
    "lg:package": "pnpm lg:build && ares-package lg-app/dist --outdir lg-app/out",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:check:crlf": "prettier --check --end-of-line crlf .",
    "dev": "pnpx tsx --env-file=.env src/app.ts",
    "prepare": "node -e \"require('fs').existsSync('.git') && require('child_process').execFileSync('git', ['config', 'core.hooksPath', '.githooks'], { stdio: 'inherit' })\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.9.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "@webos-tools/cli": "^3.2.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "express": "^5.2.1",
    "qrcode-terminal": "^0.12.0",
    "rpi-led-matrix": "^1.15.0",
    "ws": "^8.21.0"
  }
}
