#!/bin/sh
# Runs the same checks as CI before each commit. Skip with: git commit --no-verify
set -e

cd "$(git rev-parse --show-toplevel)"

pnpm build
pnpm lint
# Windows checkouts use CRLF (core.autocrlf), so Prettier must accept CRLF there.
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) pnpm format:check:crlf ;;
  *) pnpm format:check ;;
esac
pnpm test
